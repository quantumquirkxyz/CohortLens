[TEMPLATE]
# --- API (apps/api) ---
PORT=8000
# Comma-separated allowed CORS origins for the API. Unset = same-origin only.
# CORS_ORIGIN=http://localhost:3000
# Rate limiting (fixed window, per client IP). Override for local load tests.
# RATE_LIMIT_MAX=300
# RATE_LIMIT_WINDOW_MS=60000
# Trust x-forwarded-for (set to 1 behind nginx / a proxy). Leave unset locally.
# TRUST_PROXY=1

# --- Web (apps/web) ---
# Port defined in apps/web/vite.config.ts (3000)
# API base URL baked into the dashboard at build time. Unset = same-origin /api
# (dev uses the Vite proxy). Set an absolute URL when they differ in prod.
# VITE_API_URL=/api

# --- PostgreSQL (docker/compose.yaml) ---
POSTGRES_PORT=5432
DATABASE_URL=postgres://cohortlens:cohortlens@localhost:5432/cohortlens

# --- Indexer (packages/indexer) — one URL per chain ---
# SUBGRAPH_URL_ETHEREUM=https://api.thegraph.com/subgraphs/name/cohortlens/ethereum

# --- Monitoring (optional) ---
# SENTRY_DSN=
