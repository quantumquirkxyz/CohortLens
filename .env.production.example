# CohortLens — production environment variables.
# Copy to `.env` (self-hosted Docker) or set per platform (Vercel/Fly.io/Neon).
# NEVER commit real secrets.

# --- PostgreSQL (Neon / Supabase / RDS, or the compose.prod.yaml service) ---
DATABASE_URL=postgres://user:password@host:5432/cohortlens

# --- API (apps/api) ---
PORT=8000
# Comma-separated browser origins allowed to call the API cross-origin.
# Only required when dashboard and API live on different origins (Vercel +
# Fly.io). Leave unset for same-origin (dev proxy / nginx proxy).
CORS_ORIGIN=https://app.cohortlens.com
# Rate limiting: max requests per client per window.
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000
# 1 when the API is only reachable through a trusted proxy (nginx, LB, Fly.io),
# which enables client IPs from the x-forwarded-for header.
TRUST_PROXY=1

# --- Web (apps/web) — build-time (Vercel env var / Docker ARG) ---
# Same-origin when served behind nginx (compose.prod.yaml); absolute URL when
# the dashboard and API are on different origins.
VITE_API_URL=/api

# --- Indexer (packages/indexer) — one URL per chain ---
SUBGRAPH_URL_ETHEREUM=https://api.thegraph.com/subgraphs/name/cohortlens/ethereum
# SUBGRAPH_URL_POLYGON=...
# SUBGRAPH_URL_ARBITRUM=...

# --- Cache (optional) — Upstash Redis (scale-out rate limiting / lens results)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Monitoring (optional) — Sentry error tracking ---
SENTRY_DSN=
