# Testnet deployment of the Lens contracts (README → Smart contracts).
# Copy to .env (forge auto-loads it from packages/contracts) and fill in.
# NEVER commit real keys.

# Wallet private key that will deploy and own the contracts (Sepolia testnet —
# fund the address with test ETH from a faucet).
PRIVATE_KEY=

# Public RPC endpoint for the target network (Sepolia).
# e.g. https://ethereum-sepolia-rpc.publicnode.com or your Infura/Alchemy URL
SEPOLIA_RPC_URL=

# Optional: treasury address for LensOracle fees (defaults to the deployer).
# LENS_TREASURY=0x...

# Optional: block explorer API key (for `--verify`).
ETHERSCAN_API_KEY=

# Deployment (dry-run first, then broadcast):
#   forge script script/Deploy.s.sol --rpc-url $SEPOLIA_RPC_URL
#   forge script script/Deploy.s.sol --rpc-url $SEPOLIA_RPC_URL --private-key $PRIVATE_KEY --broadcast
#   forge script script/Deploy.s.sol --rpc-url $SEPOLIA_RPC_URL --private-key $PRIVATE_KEY --broadcast --verify --etherscan-api-key $ETHERSCAN_API_KEY
